{
  "name": "relayops",
  "version": "1.0.0",
  "description": "Team-based incident response API and retro operations dashboard",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs",
    "db:migrate": "node --env-file=.env src/db/migrate.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test:unit": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/auth.test.js tests/auth-email-verification.test.js tests/team-membership.test.js tests/health.test.js tests/incident-audit.test.js tests/incident-authorization.test.js tests/incident-http-authorization.test.js tests/incident-integrity.test.js tests/team-webhook-secret-http.test.js tests/webhook-http.test.js tests/webhook-service.test.js",
    "db:migrate:deploy": "node --env-file-if-exists=.env src/db/migrate.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "incident-response",
    "webhooks",
    "express",
    "postgresql",
    "react",
    "operations-dashboard"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
