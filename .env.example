NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DATABASE_URL=postgresql://relayops_app:CHANGE_ME@localhost:5432/relayops
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
LOG_LEVEL=info

FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Email verification delivery via Resend (required for new production registrations)
RESEND_API_KEY=
MAIL_FROM=RelayOps <no-reply@your-verified-domain.com>

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your_new_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME=RelayOps